<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Solid Theme: Required for Content-only Blur -->
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:windowIsTranslucent">false</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Rounded Section Backgrounds for Preferences -->
        <item name="preferenceCategoryStyle">@style/ModernPreferenceCategory</item>
    </style>

    <style name="ModernPreferenceCategory" parent="Preference.Category">
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
        <item name="android:layout">@layout/modern_preference_category</item>
    </style>

    <style name="PixelAodTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">30sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>
</resources>