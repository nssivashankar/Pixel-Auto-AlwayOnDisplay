<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- 1. The Real Content (Compose) -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/settings_compose_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. The Glass Header Layer -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <FrameLayout
            android:id="@+id/glass_header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- iOS Style Ultra-Frosted Lens -->
            <View
                android:id="@+id/header_blur_mirror"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- iOS Translucent Tint -->
            <View
                android:id="@+id/header_glass_tint"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/colorSurface"
                android:alpha="0.7" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="@android:color/transparent"
                    app:title="Pixel AOD"
                    app:titleTextAppearance="@style/PixelAodTitle"
                    app:titleTextColor="?attr/colorOnSurface">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/master_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginEnd="16dp" />

                </com.google.android.material.appbar.MaterialToolbar>

                <!-- Visual Separator for Header vs Content -->
                <View
                    android:id="@+id/header_separator"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOutlineVariant"
                    android:alpha="0.2" />

            </LinearLayout>
        </FrameLayout>

    </com.google.android.material.appbar.AppBarLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>